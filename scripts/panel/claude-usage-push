#!/usr/bin/env bash
# Push trimmed claude-usage plus running Claude Code sessions to lat for the
# Apple Watch complication. Served at https://gautenybo.no/watch_data/claude.json
set -euo pipefail
claude-usage --json | python3 -c '
import glob, json, os, sys, time

u = json.load(sys.stdin)
f, s = u.get("five_hour") or {}, u.get("seven_day") or {}
now = time.time()
ACTIVE = 90  # a session log written within this many seconds counts as working

def newest(paths):
    return max((os.path.getmtime(p) for p in paths), default=0)

TOKCACHE = os.path.expanduser("~/.cache/claude-usage/push-tokens.json")
try:
    with open(TOKCACHE) as fh:
        tokcache = json.load(fh)
except (OSError, ValueError):
    tokcache = {}

def session_tokens(path):
    # Input + output + cache writes, summed incrementally from where the last run stopped.
    # Cache reads are left out; they would dwarf everything else.
    c = tokcache.get(path) or {"offset": 0, "tokens": 0, "last_id": None}
    try:
        with open(path, "rb") as fh:
            fh.seek(c["offset"])
            data = fh.read()
    except OSError:
        return None
    end = data.rfind(b"\n") + 1  # only complete lines; a partial one is read next time
    for line in data[:end].splitlines():
        if b"\"usage\"" not in line:
            continue
        try:
            msg = json.loads(line).get("message") or {}
        except ValueError:
            continue
        us = msg.get("usage")
        # One API response is split over several lines sharing an id and the same usage.
        if not us or msg.get("id") == c["last_id"]:
            continue
        c["last_id"] = msg.get("id")
        c["tokens"] += sum(us.get(k) or 0 for k in ("input_tokens", "output_tokens", "cache_creation_input_tokens"))
    c["offset"] += end
    tokcache[path] = c
    return c["tokens"]

def session_title(meta, data):
    # A user-set name wins, then the latest AI title in the transcript.
    if meta.get("name") and meta.get("nameSource") != "derived":
        return meta["name"]
    i = max(data.rfind(b"\"customTitle\":\""), data.rfind(b"\"aiTitle\":\""))
    if i >= 0:
        j = data.find(b"\n", i)
        try:
            d = json.loads(data[data.rfind(b"\n", 0, i) + 1:j if j >= 0 else None])
            return d.get("customTitle") or d.get("aiTitle")
        except ValueError:
            pass
    return meta.get("name")

def session_state(pid):
    # Claude Code keeps ~/.claude/sessions/<pid>.json with the start cwd and busy/idle status.
    # Several sessions can share one project dir, so the dir mtime cannot tell them apart.
    try:
        with open(os.path.expanduser(f"~/.claude/sessions/{pid}.json")) as fh:
            meta = json.load(fh)
    except (OSError, ValueError):
        meta = {}
    cwd = meta.get("cwd")
    if not cwd:
        try:
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            return None
    proj = os.path.expanduser("~/.claude/projects/") + cwd.replace("/", "-").replace(".", "-")
    log = proj + "/" + meta["sessionId"] + ".jsonl" if meta.get("sessionId") else None
    # status is busy, shell (waiting on a Bash command) or idle; older versions lack it.
    if meta.get("status"):
        working = meta["status"] != "idle"
    else:
        working = now - newest(glob.glob(log or proj + "/*.jsonl")) < ACTIVE
    data = b""
    if log:
        try:
            with open(log, "rb") as fh:
                data = fh.read()
        except OSError:
            pass
    started = meta.get("startedAt", 0) / 1000 or os.stat(f"/proc/{pid}").st_mtime
    dir_ = os.path.basename(cwd) or "/"
    # Bash tool commands, foreground or background, run as direct shell children of the claude process.
    shells = []
    for line in os.popen(f"ps --ppid {pid} -o comm=,etimes=").read().splitlines():
        comm, _, age = line.rpartition(" ")
        if comm.strip() in ("bash", "sh", "zsh") and age.isdigit():
            shells.append(int(age))
    return {"shells": len(shells), "shell_age": max(shells, default=0),
            "dir": dir_, "name": session_title(meta, data) or dir_, "working": working,
            "started": int(started), "since": int(meta.get("statusUpdatedAt", 0) / 1000) or None,
            "tokens": session_tokens(log) if data else None}

sessions = [x for x in map(session_state, os.popen("pgrep -x claude").read().split()) if x]
# Forget transcripts that no running session uses any more.
live = {k: v for k, v in tokcache.items() if os.path.exists(k) and now - os.path.getmtime(k) < 7 * 86400}
os.makedirs(os.path.dirname(TOKCACHE), exist_ok=True)
with open(TOKCACHE + ".tmp", "w") as fh:
    json.dump(live, fh)
os.replace(TOKCACHE + ".tmp", TOKCACHE)

subagents = sum(1 for p in glob.glob(os.path.expanduser("~/.claude/projects/*/*/subagents/*.jsonl"))
                if now - os.path.getmtime(p) < ACTIVE)

print(json.dumps({
    "five_hour": {"percent": f.get("percent"), "resets_clock": f.get("resets_clock"), "resets_epoch": f.get("resets_epoch")},
    "seven_day": {"percent": s.get("percent"), "resets_day": s.get("resets_day"), "resets_epoch": s.get("resets_epoch")},
    "agents": {"running": len(sessions), "working": sum(x["working"] for x in sessions),
               "subagents": subagents, "sessions": sessions},
    "error": u.get("error"),
    "updated": int(now),
}))' | ssh -o BatchMode=yes lat 'cat > /var/www/twitterclone/watch_data/claude.json.tmp && mv /var/www/twitterclone/watch_data/claude.json.tmp /var/www/twitterclone/watch_data/claude.json'
